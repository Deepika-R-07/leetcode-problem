class Solution {
    public int[] singleNumber(int[] nums) {
        HashMap<Integer,Integer> h=new HashMap<>();
        for(int num:nums){
            h.put(num,h.getOrDefault(num,0)+1);

        }
        int[] res=new int[2];
        int i=0;
        for(int num:h.keySet()){
            if(h.get(num)==1){
                res[i]=num;
                i++;

            }
        }
        return res;
  

    }
}
