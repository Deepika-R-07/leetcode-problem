class Solution {
    public int findMin(int[] nums) {
       int min=Integer.MAX_VALUE;
       for(int i=0;i<nums.length;i++){
        if(nums.length<=1){
            min=nums[0];
        }
        else {
            if(nums[i]<min){
            min=nums[i];
        }
        }
        
       }
        return min;
        
    }
}
