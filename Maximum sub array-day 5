class Solution {
    public int maxSubArray(int[] nums) {
        int maxi=nums[0];
        int s=nums[0];
        for(int i=1;i<nums.length;i++){
            s=Math.max(nums[i],nums[i]+s);
            maxi=Math.max(s,maxi);

            
            
        }
        return maxi;
        
    }
}
