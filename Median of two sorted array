class Solution {
    public double findMedianSortedArrays(int[] nums1, int[] nums2) {
        int[] a=new int[nums1.length+nums2.length];
        for(int i=0;i<nums1.length;i++){
            a[i]=nums1[i];
        }
        for(int i=0;i<nums2.length;i++){
            a[nums1.length+i]=nums2[i];
        }
        double med;
        int n=a.length;
        Arrays.sort(a);
        if(n%2!=0){
            med=a[n/2];
        }

        else{
             med=(a[(n/2)-1]+a[n/2])/2.0;
            
        }
      
       return med;
        
        
    }
}
